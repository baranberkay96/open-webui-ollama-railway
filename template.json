{
  "name": "Open WebUI v0.12 + Ollama Private AI",
  "description": "Your own private AI chat: run open models, add web search, RAG and multi-user.",
  "category": "AI/ML",
  "tags": [
    "open-webui",
    "ollama",
    "llm",
    "chatgpt-alternative",
    "rag",
    "searxng",
    "pgvector",
    "private-ai"
  ],
  "upstream": {
    "repo": "open-webui/open-webui",
    "version": "v0.12.0",
    "checked": "2026-10-11"
  },
  "services": {
    "Open WebUI": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/open-webui.svg",
      "source": {
        "image": "ghcr.io/open-webui/open-webui:v0.12.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/app/backend/data"
      },
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "HTTP port (public domain target).",
          "required": false
        },
        "HOST": {
          "defaultValue": "0.0.0.0",
          "description": "Bind address. 0.0.0.0, not '::': single-worker uvicorn on '::' is IPv6-only and Railway's healthcheck connects over IPv4.",
          "required": false
        },
        "WEBUI_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL (links, OAuth callbacks, notifications).",
          "required": false
        },
        "WEBUI_SECRET_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs sessions/JWTs and encrypts OAuth tokens. Never change after first boot.",
          "required": false
        },
        "WEBUI_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Email (login) of the admin account created on first boot. Sign-up is disabled once it exists.",
          "required": true
        },
        "WEBUI_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password of the bootstrap admin account (generated). Change it after first login.",
          "required": false
        },
        "WEBUI_ADMIN_NAME": {
          "defaultValue": "Admin",
          "description": "Display name of the bootstrap admin.",
          "required": false
        },
        "DEFAULT_USER_ROLE": {
          "defaultValue": "pending",
          "description": "Role for users who sign up later (admin approves them).",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Postgres for users, chats, settings and knowledge metadata.",
          "required": false
        },
        "DATABASE_POOL_SIZE": {
          "defaultValue": "10",
          "description": "SQLAlchemy pool size per worker.",
          "required": false
        },
        "DATABASE_POOL_MAX_OVERFLOW": {
          "defaultValue": "5",
          "description": "Extra connections above the pool size.",
          "required": false
        },
        "DATABASE_POOL_RECYCLE": {
          "defaultValue": "1800",
          "description": "Recycle DB connections after N seconds.",
          "required": false
        },
        "VECTOR_DB": {
          "defaultValue": "pgvector",
          "description": "Store RAG embeddings in Postgres (pgvector) instead of the embedded Chroma.",
          "required": false
        },
        "PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH": {
          "defaultValue": "1536",
          "description": "Vector column size; fits nomic-embed-text (768, zero-padded) and 1536-dim API embeddings. Fixed after first use.",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis for app state, task control and websockets.",
          "required": false
        },
        "WEBSOCKET_MANAGER": {
          "defaultValue": "redis",
          "description": "Socket.IO state in Redis (required for more than one worker).",
          "required": false
        },
        "ENABLE_WEBSOCKET_SUPPORT": {
          "defaultValue": "true",
          "description": "Real-time streaming over websockets.",
          "required": false
        },
        "UVICORN_WORKERS": {
          "defaultValue": "1",
          "description": "Uvicorn worker processes. Raise to 2-4 after the first successful boot (migrations run per worker at startup).",
          "required": false
        },
        "OLLAMA_BASE_URL": {
          "defaultValue": "http://${{Ollama.RAILWAY_PRIVATE_DOMAIN}}:11434",
          "description": "Private Ollama endpoint.",
          "required": false
        },
        "DEFAULT_MODELS": {
          "defaultValue": "llama3.2:3b",
          "description": "Model preselected for new chats.",
          "required": false
        },
        "RAG_EMBEDDING_ENGINE": {
          "defaultValue": "ollama",
          "description": "Compute document embeddings with Ollama (no local embedding model in this container).",
          "required": false
        },
        "RAG_EMBEDDING_MODEL": {
          "defaultValue": "nomic-embed-text:v1.5",
          "description": "Embedding model pulled by the Ollama service.",
          "required": false
        },
        "ENABLE_WEB_SEARCH": {
          "defaultValue": "true",
          "description": "Enable web search in chats.",
          "required": false
        },
        "WEB_SEARCH_ENGINE": {
          "defaultValue": "searxng",
          "description": "Use the private SearXNG service.",
          "required": false
        },
        "SEARXNG_QUERY_URL": {
          "defaultValue": "http://${{SearXNG.RAILWAY_PRIVATE_DOMAIN}}:8080/search",
          "description": "SearXNG search endpoint (JSON format).",
          "required": false
        },
        "WEB_SEARCH_RESULT_COUNT": {
          "defaultValue": "5",
          "description": "Search results fetched per query.",
          "required": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "Optional: add an OpenAI (or compatible) key to use hosted models alongside local ones.",
          "required": false
        },
        "CORS_ALLOW_ORIGIN": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Allowed browser origins (semicolon-separated).",
          "required": false
        },
        "ANONYMIZED_TELEMETRY": {
          "defaultValue": "false",
          "description": "Disable anonymous telemetry.",
          "required": false
        },
        "DO_NOT_TRACK": {
          "defaultValue": "true",
          "description": "Disable tracking.",
          "required": false
        },
        "SCARF_NO_ANALYTICS": {
          "defaultValue": "true",
          "description": "Disable Scarf analytics.",
          "required": false
        }
      }
    },
    "Ollama": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/ollama.svg",
      "source": {
        "repo": "baranberkay96/open-webui-ollama-railway",
        "rootDirectory": "/services/ollama"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/root/.ollama"
      },
      "variables": {
        "PORT": {
          "defaultValue": "11434",
          "description": "Ollama API port (private).",
          "required": false
        },
        "OLLAMA_HOST": {
          "defaultValue": "[::]:11434",
          "description": "Bind address for the Ollama API (IPv4+IPv6).",
          "required": false
        },
        "OLLAMA_PULL_MODELS": {
          "defaultValue": "llama3.2:3b,nomic-embed-text:v1.5",
          "description": "Models pulled on first boot (comma-separated): a chat model and the RAG embedding model.",
          "required": false
        },
        "OLLAMA_CONTEXT_LENGTH": {
          "defaultValue": "8192",
          "description": "Default context window for chats with documents/web results.",
          "required": false
        },
        "OLLAMA_KEEP_ALIVE": {
          "defaultValue": "5m",
          "description": "Unload idle models after this time to free RAM.",
          "required": false
        },
        "OLLAMA_MAX_LOADED_MODELS": {
          "defaultValue": "2",
          "description": "Keep chat + embedding model loaded together.",
          "required": false
        }
      }
    },
    "SearXNG": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/searxng.svg",
      "source": {
        "repo": "baranberkay96/open-webui-ollama-railway",
        "rootDirectory": "/services/searxng"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "SearXNG port (private).",
          "required": false
        },
        "SEARXNG_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "SearXNG server secret.",
          "required": false
        },
        "SEARXNG_BASE_URL": {
          "defaultValue": "http://${{RAILWAY_PRIVATE_DOMAIN}}:8080/",
          "description": "Internal base URL (instance is private-only).",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "pgvector/pgvector:0.8.7-pg18-trixie"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres database.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    },
    "Redis": {
      "icon": "https://cdn.sanity.io/images/sy1jschh/production/0ce0bfdcfbdbf69662b1116671f97c2dd788b655-157x157.svg",
      "source": {
        "image": "redis:8.2"
      },
      "startCommand": "/bin/sh -c \"rm -rf $RAILWAY_VOLUME_MOUNT_PATH/lost+found/ && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save 60 1 --dir $RAILWAY_VOLUME_MOUNT_PATH\"",
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "REDISHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private network hostname of the Redis service, only resolvable from services in the same environment",
          "required": false
        },
        "REDISPORT": {
          "defaultValue": "6379",
          "description": "Port that Redis listens on",
          "required": false
        },
        "REDISUSER": {
          "defaultValue": "default",
          "description": "Username for authenticating with Redis",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "redis://${{ REDISUSER }}:${{ REDIS_PASSWORD }}@${{ REDISHOST }}:${{ REDISPORT }}",
          "description": "Connection string for connecting to Redis using the private network",
          "required": false
        },
        "REDISPASSWORD": {
          "defaultValue": "${{REDIS_PASSWORD}}",
          "description": "Alias of REDIS_PASSWORD for clients that expect the unseparated name",
          "required": false
        },
        "REDIS_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Randomly generated password for authenticating with Redis",
          "required": false
        }
      }
    }
  },
  "buckets": []
}
